{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS-Q Password",
  "version": "0.1.0",
  "identifier": "org.nexusq.password",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "NEXUS-Q Password",
      "width": 1440,
      "height": 940,
      "minWidth": 980,
      "minHeight": 680,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://localhost:1421 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Local-first encrypted password manager",
    "longDescription": "NEXUS-Q Password is an independent local-first desktop password manager with an encrypted credential vault."
  }
}
